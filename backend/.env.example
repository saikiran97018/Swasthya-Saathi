# Copy to `.env` and fill in. Never commit the real .env file.

# --- app -------------------------------------------------------------------
ENVIRONMENT=development            # development | production (production refuses the default JWT secret)
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL ------------------------------------------------------------
# Create the database first:  createdb voiceagent   (or: CREATE DATABASE voiceagent;)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/voiceagent
# Leave false and use `alembic upgrade head`. true = create tables from the models (quick demos only).
AUTO_CREATE_TABLES=false
# Seed the knowledge base + helpline directory when empty.
AUTO_SEED=true

# --- auth ------------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_MINUTES=10080

# --- speech (speech-to-text + text-to-speech) -------------------------------
# auto = Sarvam when SARVAM_API_KEY is set, otherwise Bhashini.  Force one with: sarvam | bhashini
SPEECH_PROVIDER=auto
# Backup used automatically if the main speech provider fails: auto (= the other one, when it has credentials) | none | sarvam | bhashini
SPEECH_FALLBACK_PROVIDER=auto

# Sarvam AI (recommended): dashboard.sarvam.ai -> API keys. New accounts get free credits (check the dashboard for the amount).
# STT = Saaras v4 (up to 30 s per recording), TTS = Bulbul v3. 11 languages can be spoken; 14+ can be understood.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_MODE=transcribe
SARVAM_TTS_MODEL=bulbul:v3
# Speakers belong to a model; these two are bulbul:v3 voices. Change them if you switch SARVAM_TTS_MODEL.
SARVAM_TTS_SPEAKER_FEMALE=priya
SARVAM_TTS_SPEAKER_MALE=shubh

# Bhashini (alternative provider). From your Bhashini/ULCA account (bhashini.gov.in -> My Profile -> API keys).
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
BHASHINI_TTS_SAMPLING_RATE=8000

# --- LLM: any OpenAI-compatible endpoint serving an open-source model ------------
# PRIMARY: Groq (free tier, fast): https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# other Groq choice: openai/gpt-oss-120b  (optional JSON merged into each request, e.g. {"reasoning_effort":"low"})
# Recommended for Groq's gpt-oss models: less hidden "thinking", so replies are faster and use fewer tokens (free tier: 8,000 tokens/minute)
LLM_EXTRA_BODY={"reasoning_effort":"low"}
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# FALLBACK (optional but recommended): used automatically when the primary is rate-limited, down or rejects the key.
# Sarvam's voice-agent model (reasoning always off, 32K context). Uses the same SARVAM_API_KEY value.
LLM_FALLBACK_BASE_URL=https://api.sarvam.ai/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=sarvam-105b-conversations
# For the general sarvam-105b model, reasoning is on by default; turn it off for snappy tool calls with:
# LLM_FALLBACK_MODEL=sarvam-105b   LLM_FALLBACK_EXTRA_BODY={"reasoning_effort": null}
LLM_FALLBACK_EXTRA_BODY=
# Fully local alternative (Ollama): LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.1:8b  (no key)
# The model must support tool calling (function calling) for the agent to use tools.
# --- optional tools --------------------------------------------------------
# Web search (enables the web_search tool). Use ONE of:
TAVILY_API_KEY=
SEARXNG_URL=

# --- healthcare behaviour --------------------------------------------------
# Outbound integration: booked / cancelled / rescheduled appointments, delivered reminders, feedback and
# assistance requests are POSTed here as {"event","data","sent_at"} with an HMAC-SHA256 signature in X-Signature.
# Point it at your hospital system (HMIS) or an SMS/WhatsApp gateway adapter. Leave empty to disable.
WEBHOOK_URL=
WEBHOOK_SECRET=
# How often (seconds) the background loop delivers due reminders. 0 = off.
REMINDER_POLL_SECONDS=30
# true = the UI shows "simulate visit / send reminder now" demo buttons (for presentations only).
DEMO_MODE=false
# Invented sample clinics with made-up schedules, for demos and tests ONLY. Leave false: real hospitals and clinics near the
# user come from OpenStreetMap (below), and a visit there is a "planned visit" the clinic has not confirmed.
SEED_DEMO_PROVIDERS=false
# Real places: Nominatim (city -> position) + Overpass (hospitals/clinics around it). Free, no key. Set false to switch off.
PLACES_ENABLED=true
# Optional, more complete lists for big cities (the public Overpass servers are often overloaded, so it is off by default):
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# ---- Live voice calls: Agora Conversational AI (real-time voice agent) + Murf Falcon (speaks the replies) ----
# Agora Console -> your project: copy the App ID and the Primary Certificate. With these two no Customer ID/Secret is needed.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Murf API key (murf.ai/api). Check every voice with:  .\.venv\Scripts\python.exe scripts\check_murf_voices.py
MURF_API_KEY= 
# MURF_VOICES={"te": "Anisha"}      # optional: pick another Falcon voice per language
# Public HTTPS address of THIS server, so Agora's cloud can reach it (ngrok / cloudflared tunnel, or a deployment), e.g.
#   AGORA_PUBLIC_URL=https://something.trycloudflare.com
# Set  -> the voice agent uses every tool (find clinics, plan visits, family, ...).
# Empty -> the agent talks to Groq directly: it can chat but cannot take actions.
AGORA_PUBLIC_URL=
# AGORA_ASR_VENDOR=ares             # ares (Agora's own) or sarvam (uses SARVAM_API_KEY)
PLANNED_VISIT_MIN_LEAD_MINUTES=120
PLANNED_VISIT_HORIZON_DAYS=60
BOOKING_HORIZON_DAYS=14
MAX_ACTIVE_APPOINTMENTS=5
# --- limits ----------------------------------------------------------------
MAX_AUDIO_BYTES=10485760
MAX_AUDIO_SECONDS=60
RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_AI_PER_MINUTE=40

# --- advanced (optional): defaults shown, change only if you know why ------------------
# APP_NAME=Swasthya Saathi
# API_PREFIX=/api/v1
# JWT_ALGORITHM=HS256
# AGENT_MAX_STEPS=5                 # most model <-> tool round trips per chat turn
# HISTORY_MESSAGE_LIMIT=30          # recent messages sent to the model each step
# SUMMARY_TRIGGER_MESSAGES=24       # start summarising older messages after this many (the newest 10 stay verbatim)
# TOOL_TIMEOUT_SECONDS=20
# LLM_TIMEOUT_SECONDS=60
# MAX_MESSAGE_CHARS=4000
# MAX_TTS_CHARS=3000
# TTS_CACHE_ITEMS=64                # in-memory cache of synthesized speech
# SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
# SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech
# SARVAM_TTS_SAMPLE_RATE=22050
# SARVAM_TIMEOUT_SECONDS=30
# BHASHINI_CONFIG_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
# BHASHINI_TIMEOUT_SECONDS=30
# BHASHINI_CONFIG_CACHE_SECONDS=3600
# TRUST_PROXY_HEADERS=false         # true only behind a trusted reverse proxy (uses X-Forwarded-For for rate limits)
